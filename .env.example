# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
#
# From your Intuit Developer app (https://developer.intuit.com -> your app -> Keys & credentials):
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Your QuickBooks Online company (realm) ID.
# You capture this from the OAuth redirect URL when you run `node authorize.js`.
QBO_REALM_ID=

# 'production' or 'sandbox'
QBO_ENVIRONMENT=production
